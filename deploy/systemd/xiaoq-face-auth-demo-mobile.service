[Unit]
Description=XiaoQ face authorization demo mobile gateway
After=network-online.target xiaoq-face-auth-demo.service
Wants=network-online.target

[Service]
Type=simple
User=johnf
WorkingDirectory=/home/johnf/xiaoq-face-auth-demo
Environment=PYTHONUNBUFFERED=1
Environment=XIAOQ_ROOT=/home/johnf/xiaoq-face-auth-demo
Environment=XIAOQ_MOBILE_PORT=8788
Environment=XIAOQ_RUNTIME_SERVICE=xiaoq-face-auth-demo.service
ExecStart=/usr/bin/python3 /home/johnf/xiaoq-face-auth-demo/mobile_control.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
