[Unit]
Description=XiaoQ face authorization demo runtime
After=network-online.target graphical.target
Wants=network-online.target

[Service]
Type=simple
User=johnf
WorkingDirectory=/home/johnf/xiaoq-face-auth-demo
Environment=PYTHONUNBUFFERED=1
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WAYLAND_DISPLAY=wayland-0
Environment=SDL_VIDEODRIVER=wayland
Environment=XIAOQ_ROOT=/home/johnf/xiaoq-face-auth-demo
Environment=XIAOQ_AUTO_FACE_TRACKING=1
Environment=XIAOQ_GESTURE_ENABLED=1
Environment=XIAOQ_FACE_AUTH_REQUIRED=1
Environment=XIAOQ_FACE_AUTH_MIN_SCORE=0.68
ExecStart=/home/johnf/xiaoq-face-auth-demo/start_xiaoq.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
