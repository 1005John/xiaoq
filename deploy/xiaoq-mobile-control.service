[Unit]
Description=XiaoQ mobile control gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=johnf
WorkingDirectory=/home/johnf/xiaoq
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/johnf/xiaoq/mobile_control.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
