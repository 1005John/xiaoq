[Unit]
Description=XiaoQ unified runtime (face, mobile, vision, ESP32, remote laptop)
After=network-online.target graphical.target
Wants=network-online.target

[Service]
Type=simple
User=johnf
WorkingDirectory=/home/johnf/xiaoq
Environment=PYTHONUNBUFFERED=1
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WAYLAND_DISPLAY=wayland-0
Environment=SDL_VIDEODRIVER=wayland
Environment=XIAOQ_AUTO_FACE_TRACKING=1
ExecStart=/home/johnf/xiaoq/start_xiaoq.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
